{
    "name": "pagasa/sso-client",
    "description": "Drop-in Laravel client for PAGASA SSO: redirect, callback, token exchange, step-up and user resolution.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["pagasa", "sso", "laravel", "authentication"],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.2|^8.0",
        "illuminate/auth": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.48|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.5|^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pagasa\\Sso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pagasa\\Sso\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pagasa\\Sso\\SsoServiceProvider"
            ],
            "aliases": {
                "Sso": "Pagasa\\Sso\\Facades\\Sso"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
